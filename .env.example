# Copy to .env and fill in. See /research/01-block-explorer-apis.md for how to obtain each key.

# Etherscan API V2 — covers Ethereum; also required (paid tier) for BNB Smart Chain
ETHERSCAN_API_KEY=

# Tronscan — free key from tronscan.org account > API Keys (effectively required as of Aug 2025)
TRONSCAN_API_KEY=

# Blockchair — optional for light use, recommended beyond ad-hoc testing
BLOCKCHAIR_API_KEY=

# GraphSense hosted API — only needed if querying api.ikna.io live instead of the git-cloned TagPacks;
# request via email, see /research/02-graphsense-tagpacks.md (contact address unconfirmed, verify first)
GRAPHSENSE_API_KEY=

# Case storage — Supabase Postgres connection string.
# supabase.com -> your project -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=

# BSCTrace (NodeReal MegaNode) — free key from dashboard.nodereal.io. Powers BNB Smart Chain support
# (app/api_clients/bsctrace.py) — code is written and schema-verified but NOT live-tested without this key.
NODEREAL_API_KEY=

# Helius — free tier, 1M credits/mo, dev.helius.xyz, no card required. Powers
# Solana SPL/USDC token transfers (app/api_clients/solana.py).
HELIUS_API_KEY=

# --- Everything below is OPTIONAL. The defaults are free and keyless. ---

# Continuous watchlist monitoring (app/api/main.py). Minutes between
# unattended sweeps of every watched address; 0 or unset = off, and the
# Alerts page says so rather than implying monitoring that isn't running.
# Each sweep re-traces every watched address against rate-limited free-tier
# explorer APIs, so leave it off during a live demo — you want that quota for
# the trace the judges are watching. /v1/watchlist/check-all runs one sweep
# on demand if you'd rather drive it from cron or Task Scheduler.
WATCHLIST_INTERVAL_MINUTES=0

# Chainalysis Sanctions Screening API — FREE, but the key is issued on
# request rather than self-serve. Ask for one at chainalysis.com (the
# "Request an API key" form on the free sanctions screening / address
# screening pages) or email the address in their oracle docs at
# go.chainalysis.com/chainalysis-oracle-docs.html.
#
# Worth requesting even though the on-chain oracle below needs no key: the
# oracle is EVM-only, so it cannot screen Bitcoin, Tron or Solana. This API
# covers every chain this tool traces, and returns the designation itself
# (name, description, link) rather than a bare true/false.
#
# Leave blank and nothing breaks — app/api_clients/chainalysis.py reports
# "not consulted" rather than inventing a clean result, and the UI, the
# summary and the evidence pack all say so explicitly.
CHAINALYSIS_API_KEY=

# Chainalysis on-chain sanctions oracle (same module) needs NO key and NO
# account — it is a public smart contract read over a public RPC. These only
# override which RPC is used; the defaults are publicnode.com, free and
# unauthenticated.
# ETH_RPC_URL=
# MATIC_RPC_URL=
# BNB_RPC_URL=

# Rupee valuation (app/prices.py) uses CoinGecko's keyless Demo tier —
# no key, no account, 100 calls/min. Set this to any value to switch the
# price feed off entirely (offline demo); the UI then shows token units only.
# DISABLE_PRICE_FEED=1

# Officer login session signing key — app/auth.py. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random one is generated at process start and every
# officer is logged out on the next restart — fine for a laptop demo, not
# for anything else.
JWT_SECRET=
