# Copy to .env and fill in. See /research/01-block-explorer-apis.md for how to obtain each key.

# Etherscan API V2 — covers Ethereum; also required (paid tier) for BNB Smart Chain
ETHERSCAN_API_KEY=

# Tronscan — free key from tronscan.org account > API Keys (effectively required as of Aug 2025)
TRONSCAN_API_KEY=

# Blockchair — optional for light use, recommended beyond ad-hoc testing
BLOCKCHAIR_API_KEY=

# GraphSense hosted API — only needed if querying api.ikna.io live instead of the git-cloned TagPacks;
# request via email, see /research/02-graphsense-tagpacks.md (contact address unconfirmed, verify first)
GRAPHSENSE_API_KEY=

# Case storage — Supabase Postgres connection string.
# supabase.com -> your project -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=
